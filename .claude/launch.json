{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kelsod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "KELSO_ROOT=/Users/nepthar/kelso",
        "uv",
        "run",
        "kelsod",
        "--port",
        "9800",
        "--host",
        "127.0.0.1",
        "--socket",
        "/tmp/kelsod-dev.sock"
      ],
      "port": 9800
    },
    {
      "name": "kelsod-scratch",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "KELSO_ROOT=/tmp/kelso-flow",
        "uv",
        "run",
        "kelsod",
        "--port",
        "9797",
        "--host",
        "127.0.0.1"
      ],
      "port": 9797
    },
    {
      "name": "kelso-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "KELSO_API=127.0.0.1:9800",
        "KELSO_UI_NO_AUTH=1",
        "KELSO_UI_ID=beef",
        "uv",
        "run",
        "--directory",
        "apps/net.klso.kelso-ui.klso/ui",
        "uvicorn",
        "server:app",
        "--port",
        "9798"
      ],
      "port": 9798
    }
  ]
}
